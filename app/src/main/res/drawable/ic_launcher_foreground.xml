<?xml version="1.0" encoding="utf-8"?>
<!--
  Beaver silhouette, side profile facing left.

  Built from overlapping primitives rather than a traced outline: at launcher
  size the legible cues are the flat paddle tail, a long low body and a blunt
  snout, and simple unioned shapes stay crisp where fine detail turns to mush.

  Three things separate a beaver from a generic rodent here, and all three were
  wrong in earlier drafts:
    - the tail is near-horizontal and overlaps the rump, so it reads as part of
      the animal rather than a plank lying next to it
    - the body is long and low, not a circle, which is what made it look like a
      bear cub
    - the ear is small and tucked; a large round ear reads as bear every time

  Everything stays inside the adaptive-icon safe zone (radius ~34 about 54,54).
  The fill is a colour resource so the silhouette inverts in dark mode.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.66"
        android:scaleY="0.66"
        android:translateX="-2"
        android:translateY="1">

        <!-- Tail: broad flat paddle, nearly level, tucked under the rump -->
        <group
            android:pivotX="87"
            android:pivotY="66"
            android:rotation="9">
            <path
                android:fillColor="@color/ic_launcher_silhouette"
                android:pathData="M79,57 H95 A9,9 0 0 1 104,66 A9,9 0 0 1 95,75 H79 A9,9 0 0 1 70,66 A9,9 0 0 1 79,57 Z" />
        </group>

        <!-- Body: long and low -->
        <path
            android:fillColor="@color/ic_launcher_silhouette"
            android:pathData="M30,56 a24,16 0 1,0 48,0 a24,16 0 1,0 -48,0 Z" />

        <!-- Hind foot -->
        <path
            android:fillColor="@color/ic_launcher_silhouette"
            android:pathData="M50,67 a10,6 0 1,0 20,0 a10,6 0 1,0 -20,0 Z" />

        <!-- Front paw -->
        <path
            android:fillColor="@color/ic_launcher_silhouette"
            android:pathData="M27,65 a7,5 0 1,0 14,0 a7,5 0 1,0 -14,0 Z" />

        <!-- Head -->
        <path
            android:fillColor="@color/ic_launcher_silhouette"
            android:pathData="M15,44 a12.5,11.5 0 1,0 25,0 a12.5,11.5 0 1,0 -25,0 Z" />

        <!-- Blunt snout, pushed forward and slightly down -->
        <path
            android:fillColor="@color/ic_launcher_silhouette"
            android:pathData="M5,49 a8,6 0 1,0 16,0 a8,6 0 1,0 -16,0 Z" />

        <!-- Ear: small and tucked against the skull -->
        <path
            android:fillColor="@color/ic_launcher_silhouette"
            android:pathData="M27,33 a4.2,4.2 0 1,0 8.4,0 a4.2,4.2 0 1,0 -8.4,0 Z" />

    </group>
</vector>
