<?xml version="1.0" encoding="utf-8"?>
<!--
  The resting face: the time and the date.

  TextClock rather than text we render ourselves. Android throttles widget
  updates to about every 30 minutes, so a clock we drew into the bitmap would be
  wrong most of the time. TextClock is one of the few views RemoteViews allows
  that the system itself ticks every minute, at no cost to the battery.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <TextClock
        android:id="@+id/widget_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="@color/sumi_ink"
        android:textSize="52sp" />

    <TextClock
        android:id="@+id/widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="serif"
        android:format12Hour="EEEE · d MMMM"
        android:format24Hour="EEEE · d MMMM"
        android:textColor="@color/sumi_ink_muted"
        android:textSize="14sp" />

</LinearLayout>
