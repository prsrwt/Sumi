<?xml version="1.0" encoding="utf-8"?>
<!--
  The resting face: the time and the date.

  The time is a TextClock, one of the few views RemoteViews allows that the system
  itself ticks every minute. Android throttles widget redraws to about every 30
  minutes, so a clock drawn into an image would be wrong most of the time. The
  date changes once a day, so it is an image drawn in Mincho (see InkText), and
  the widget redraws just after midnight to turn it over.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <TextClock
        android:id="@+id/widget_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="@color/sumi_ink"
        android:textSize="52sp" />

    <ImageView
        android:id="@+id/widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no" />

</LinearLayout>
