<?xml version="1.0" encoding="utf-8"?>
<!--
  The asking face: a question in place of the time, with the time kept small
  underneath so the widget never stops being useful as a clock.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <TextView
        android:id="@+id/widget_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/sumi_ink"
        android:textSize="24sp" />

    <TextClock
        android:id="@+id/widget_small_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="serif"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="@color/sumi_ink_muted"
        android:textSize="14sp" />

</LinearLayout>
