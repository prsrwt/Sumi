<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's frame: the glass bitmap underneath, and the face's text layout
  added on top at each redraw (see SumiWidget). Empty until the first redraw,
  which follows the moment the widget is placed.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <FrameLayout
        android:id="@+id/widget_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
