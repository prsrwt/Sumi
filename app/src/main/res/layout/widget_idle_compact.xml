<?xml version="1.0" encoding="utf-8"?>
<!-- The resting face at one row tall: time and date side by side. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <TextClock
        android:id="@+id/widget_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="@color/sumi_ink"
        android:textSize="32sp" />

    <TextClock
        android:id="@+id/widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="serif"
        android:format12Hour="EEEE · d MMM"
        android:format24Hour="EEEE · d MMM"
        android:maxLines="1"
        android:textColor="@color/sumi_ink_muted"
        android:textSize="14sp" />

</LinearLayout>
