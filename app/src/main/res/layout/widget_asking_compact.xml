<?xml version="1.0" encoding="utf-8"?>
<!--
  The asking face at one row tall: the question takes the space it needs and
  gives up the rest to the small clock on the right. One line, so a long
  phrasing ellipsizes rather than pushing the clock off the glass.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/widget_question"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/sumi_ink"
        android:textSize="18sp" />

    <TextClock
        android:id="@+id/widget_small_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="serif"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="@color/sumi_ink_muted"
        android:textSize="14sp" />

</LinearLayout>
