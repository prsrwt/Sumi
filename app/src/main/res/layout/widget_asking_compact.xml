<?xml version="1.0" encoding="utf-8"?>
<!--
  The asking face at one row tall: the Mincho question takes the space it needs
  and gives up the rest to the small live clock on the right. The question image
  is drawn to fit that space, cut short with an ellipsis if it must be.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">

    <ImageView
        android:id="@+id/widget_question"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitStart" />

    <TextClock
        android:id="@+id/widget_small_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="@color/sumi_ink_muted"
        android:textSize="14sp" />

</LinearLayout>
