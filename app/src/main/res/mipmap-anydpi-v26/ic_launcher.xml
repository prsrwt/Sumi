<?xml version="1.0" encoding="utf-8"?>
<!--
  Sumi's ensō icon. The source painting (design/icon/sumi-icon-source.jpeg) came
  with its own rounded card and drop shadow; launchers cut every icon to their own
  shape, so that card would have shown up as an icon inside an icon. The layers use
  the painting only, padded with matching paper, and the launcher supplies the
  shape. The monochrome layer is the ink alone, for Android 13 themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
